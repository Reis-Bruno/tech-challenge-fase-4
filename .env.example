# Backend de embeddings usado na indexação: fastembed (neural, padrão) | lsa (offline)
VOC_EMBEDDING_BACKEND=fastembed
# VOC_FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Gerador: none (extrativo, sem LLM) | openai | gemini | anthropic | ollama
VOC_LLM_PROVIDER=none
# VOC_LLM_MODEL=gpt-4o-mini
# VOC_LLM_TEMPERATURE=0.1

# Chaves (preencha só a do provedor escolhido)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
