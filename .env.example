# Backend de embeddings usado na indexação: fastembed (neural, padrão) | lsa (offline)
VOC_EMBEDDING_BACKEND=fastembed
# VOC_FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Gerador: gemini (padrão) | openai | anthropic | ollama | none (extrativo, sem LLM)
# Se VOC_LLM_PROVIDER não for definido: usa gemini quando GEMINI_API_KEY existir, senão none.
VOC_LLM_PROVIDER=gemini
# VOC_LLM_MODEL=gemini-3.5-flash
# VOC_LLM_TEMPERATURE=0.1

# Chaves (preencha só a do provedor escolhido)
# OPENAI_API_KEY=
# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434/v1
